<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AIDA Linux</vendor>
  <vendor_url>https://github.com/mengzhihua/aida</vendor_url>
  <icon_name>aida</icon_name>

  <action id="com.aida.linux.elevate">
    <description>Run AIDA Linux with administrator privileges</description>
    <description xml:lang="zh_CN">以管理员权限运行 AIDA Linux</description>
    <message>AIDA Linux 需要管理员权限才能读取 DMI 序列号/UUID 和 NVMe SMART。</message>
    <message xml:lang="en">AIDA Linux needs administrator privileges to read DMI serial/UUID and NVMe SMART.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <!-- 发行版包装安装到 /usr/bin/aida。AppImage 走 pkexec 的通用 exec 策略。 -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/aida</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
